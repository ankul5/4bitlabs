{
  "name": "4bitlabs-backend",
  "version": "1.0.0",
  "description": "4Bit Labs EdTech Backend — Node.js + Express + PostgreSQL + Firebase",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node run_schema.js",
    "db:verify": "node -e \"require('dotenv').config(); const {pool}=require('./src/config/database'); pool.query('SELECT tablename FROM pg_tables WHERE schemaname=\\'public\\' ORDER BY tablename').then(r=>{console.log('Tables:',r.rows.map(x=>x.tablename));pool.end()}).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "edtech",
    "4bitlabs",
    "nodejs",
    "express"
  ],
  "author": "4Bit Labs",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.103.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cache": "^5.1.2",
    "pg": "^8.20.0",
    "pg-format": "^1.0.4",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
